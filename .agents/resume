#!/usr/bin/env bash
set -euo pipefail

readonly REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Amp materializes private User Skills only after authenticated session startup.
# Invocation repeats this sync and fails closed if the inventory is unavailable.
if ! python3 "$REPO_ROOT/scripts/sync-opencode-skills.py" --quiet; then
  printf 'OpenCode User Skill sync deferred until invocation\n' >&2
fi
